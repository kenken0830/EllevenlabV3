{
  "name": "note2voice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "note2voice": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "cli": "node dist/src/cli.js",
    "start": "node dist/src/server.js",
    "web": "npm run build && npm run start"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@biomejs/cli-win32-x64": "^2.4.7",
    "@rollup/rollup-win32-x64-msvc": "^4.59.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "openai": "^6.29.0"
  }
}
